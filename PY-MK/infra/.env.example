# Variables de entorno para Docker Compose
# Copia este archivo a infra/.env y ajusta los valores según tu entorno

# URL que el frontend usa para llamar al backend
# Desarrollo local:
NEXT_PUBLIC_API_URL=http://localhost:8024/api/v1

# Red interna (universidad, trabajo):
# NEXT_PUBLIC_API_URL=http://192.168.1.x:8024/api/v1

# Producción:
# NEXT_PUBLIC_API_URL=https://api.tudominio.com/api/v1

# Clave con la que se crean TODOS los usuarios de siembra.
#
# En desarrollo se puede dejar vacia: seed.py usa las claves que estan
# escritas en el codigo y el entorno local sigue funcionando igual.
#
# En produccion es OBLIGATORIA si se quiere sembrar: sin ella, la siembra se
# niega a correr. El motivo es que este repositorio va a ser publico, y con
# las claves solo en el codigo cualquiera que despliegue sin poner
# APP_ENV=production levanta un admin con credencial conocida.
#
# SEED_PASSWORD=

# Capsulas de funcionalidad encendidas, separadas por comas. Vacio = ninguna.
# Ver DOCUMENTOS/ESTRATEGIA/10-MODULOS-ACTIVABLES.md
#
# "telemetria" esta apagada: los conectores son simulados.
# CAPSULAS_ACTIVAS=telemetria
# NEXT_PUBLIC_CAPSULAS_ACTIVAS=telemetria
